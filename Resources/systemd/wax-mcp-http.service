# Shared Wax MCP HTTP server as a systemd user unit: the Linux counterpart of
# the ai.wax.mcp-http LaunchAgent. Install it with:
#   cp wax-mcp-http.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now wax-mcp-http.service
# The launcher is the one `waxmcp install` stages. With a custom
# WAX_MCP_INSTALL_ROOT, point ExecStart at <root>/bin/start-wax-mcp-http.sh.
[Unit]
Description=Wax MCP HTTP server (shared memory for local agents)

[Service]
Type=simple
ExecStart=%h/.local/share/waxmcp/bin/start-wax-mcp-http.sh
Environment=WAX_BROKER_START_TIMEOUT_SECS=60
# KeepAlive: restart whenever it exits. 10 s matches launchd's default throttle.
Restart=always
RestartSec=10
# SIGTERM reaches wax-mcp and its wax-cli broker daemon. The daemon drains
# admitted requests for at most 1 s and must exit within the client's 2 s
# grace; 5 s covers both and the HTTP teardown before systemd sends SIGKILL.
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=default.target
